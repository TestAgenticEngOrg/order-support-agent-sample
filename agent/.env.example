# Orders MCP server, e.g. http://localhost:9090/mcp for a local run.
ORDERS_MCP_URL=

# Agent Manager injects LLM_PROVIDER_URL and LLM_PROVIDER_KEY when an LLM provider
# is bound to the agent. For a local run without Agent Manager, set
# USE_LLM_PROVIDER=false and provide OPENAI_API_KEY instead.
USE_LLM_PROVIDER=true
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=
# OPENAI_API_KEY=

